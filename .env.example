# =============================================================================
# CYTADELA DURMSTRANG — PRZYKŁADOWA KONFIGURACJA (.env.example)
# =============================================================================

PORT=3001

# Dane z Discord Developer Portal (https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=twoj_bot_token_tutaj
DISCORD_CLIENT_ID=twoje_application_client_id_tutaj
DISCORD_GUILD_ID=opcjonalne_id_serwera
# Opcjonalne, lecz zalecane: ID prywatnego kanału #loża-arcymistrzów.
# Bez tej wartości bot spróbuje odnaleźć kanał automatycznie po nazwie.
DISCORD_RECRUITMENT_CHANNEL_ID=opcjonalne_id_kanalu_lozy

# Codzienny plan lekcji (domyślnie o 07:00 czasu Europe/Warsaw).
# Bez ID bot spróbuje odnaleźć kanał #plan-lekcji po nazwie.
DISCORD_TIMETABLE_ENABLED=true
DISCORD_TIMETABLE_POST_TIME=07:00
DISCORD_TIMETABLE_CHANNEL_ID=opcjonalne_id_kanalu_plan_lekcji

FRONTEND_URL=http://localhost:5173

# Publiczny adres portalu używany w linkach Statutu i Vademecum.
# W produkcji musi to być domena dostępna dla odbiorców wiadomości (bez localhost).
APP_URL=https://twoja-domena.example

# Prawdziwe, stałe zaproszenie do oficjalnego serwera społeczności.
DISCORD_INVITE_URL=https://discord.gg/twoje-zaproszenie

# Wysyłka transakcyjna SMTP (np. Brevo, Mailgun, własny serwer pocztowy).
# Ustaw MAIL_TRANSPORT=json wyłącznie lokalnie, aby przechwytywać wiadomości bez wysyłki.
MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=twoj_uzytkownik_smtp
SMTP_PASS=twoje_haslo_smtp
MAIL_FROM_ADDRESS=kancelaria@twoja-domena.example
MAIL_FROM_NAME=Rada Arcymistrzów • Twierdza Magii Durmstrang
MAIL_REPLY_TO=kontakt@twoja-domena.example
